  <style>
    #dna-scale-picker { display: none !important; }
    body.home-page {
      background-color: var(--bg-page) !important;
      color: var(--text-primary) !important;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
      box-sizing: border-box;
      margin: 0;
    }

    /* ── Header da Capa ── */
    .home-header {
      padding: 0.85rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      background: var(--bg-header);
      flex-shrink: 0;
      box-shadow: 0 1px 3px rgba(15,23,42,.04);
    }
    .hh-logo-area {
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .dna-logo-img {
      height: 52px;
      max-height: 54px;
      width: auto;
      object-fit: contain;
      display: block;
      transition: opacity .2s ease;
    }
    [data-theme="light"] .dna-logo-img {
      content: url('logo-dna-blue.png');
    }
    .hh-divider {
      width: 1.5px;
      height: 24px;
      background: var(--border);
      opacity: 0.7;
      display: inline-block;
    }
    .hh-bimbo-logo {
      height: 22px;
      max-height: 24px;
      width: auto;
      object-fit: contain;
      display: block;
      opacity: 0.82;
      filter: saturate(0.65) brightness(0.92);
      transition: opacity .2s ease, filter .2s ease;
    }
    .hh-bimbo-logo:hover {
      opacity: 0.95;
      filter: saturate(0.85) brightness(0.98);
    }
    [data-theme="light"] .hh-bimbo-logo {
      opacity: 0.74;
      filter: saturate(0.58) brightness(0.86);
    }
    [data-theme="light"] .hh-bimbo-logo:hover {
      opacity: 0.92;
      filter: saturate(0.80) brightness(0.95);
    }

    /* ── Hero da Capa (Sóbrio D&A Brasil) ── */
    .home-hero {
      text-align: center;
      padding: 1.5rem 1.5rem 0.75rem;
      flex-shrink: 0;
    }
    .hero-eyebrow {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--link);
      margin-bottom: .45rem;
    }
    .hero-page-title {
      font-size: clamp(1.8rem, 3.2vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -.02em;
      color: var(--text-primary);
      text-transform: uppercase;
      margin: 0 0 .4rem 0;
    }
    .hero-subtitle {
      font-size: clamp(0.9rem, 1.2vw, 0.98rem);
      color: var(--text-muted);
      max-width: 680px;
      margin: 0 auto;
      line-height: 1.5;
    }
    .hero-title-line {
      width: 48px;
      height: 3px;
      background: var(--primary);
      border-radius: 3px;
      margin: .8rem auto 0;
    }

    /* ── Seção de Módulos (Grid Desktop: 3 acima, 2 centralizados abaixo) ── */
    .modules-section {
      max-width: 1240px;
      width: 100%;
      margin: 0.75rem auto 1.5rem;
      padding: 0 1.5rem;
      flex: 1;
      display: flex;
      align-items: center;
      box-sizing: border-box;
    }
    .modules-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1.25rem;
      width: 100%;
    }
    .modules-grid > .mc-wrap {
      grid-column: span 2;
    }
    /* Centralização dos dois módulos da 2ª linha (Governança e Relatórios) */
    .modules-grid > .mc-wrap.mc-gov {
      grid-column: 2 / span 2;
    }
    .modules-grid > .mc-wrap.mc-rep {
      grid-column: 4 / span 2;
    }

    /* ── Cartão do Módulo ── */
    .mc-wrap {
      text-decoration: none;
      border-radius: var(--r-card, 14px);
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-card);
      padding: 1.35rem 1.4rem;
      display: flex;
      flex-direction: column;
      transition: transform .22s cubic-bezier(0.16, 1, 0.3, 1), border-color .22s ease, box-shadow .22s ease;
      position: relative;
      outline: none;
      box-sizing: border-box;
    }
    .mc-wrap:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: 0 12px 32px rgba(15, 23, 42, 0.16);
    }
    .mc-wrap:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
      border-color: var(--primary);
    }

    .mc-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.85rem;
    }
    .mc-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid transparent;
      flex-shrink: 0;
    }
    .mc-icon svg { width: 22px; height: 22px; }

    /* Variantes dos blocos de ícones no padrão corporativo D&A */
    .mc-exec .mc-icon { background: var(--tint-blue); color: #2563eb; border-color: rgba(37,99,235,.2); }
    .mc-spend .mc-icon { background: var(--tint-teal); color: #0284c7; border-color: rgba(2,132,199,.2); }
    .mc-ord .mc-icon { background: var(--tint-amber); color: #b45309; border-color: rgba(180,83,9,.2); }
    .mc-com .mc-icon { background: var(--tint-green); color: #15803d; border-color: rgba(21,128,61,.2); }
    .mc-gov .mc-icon { background: var(--tint-teal); color: #0f766e; border-color: rgba(15,118,110,.25); }
    .mc-rep .mc-icon { background: var(--tint-blue); color: #1d4ed8; border-color: rgba(29,78,216,.2); }

    [data-theme="dark"] .mc-exec .mc-icon { color: #60a5fa; border-color: rgba(96,165,250,.3); }
    [data-theme="dark"] .mc-spend .mc-icon { color: #38bdf8; border-color: rgba(56,189,248,.3); }
    [data-theme="dark"] .mc-ord .mc-icon { color: #fbbf24; border-color: rgba(251,191,36,.3); }
    [data-theme="dark"] .mc-com .mc-icon { color: #4ade80; border-color: rgba(74,222,128,.3); }
    [data-theme="dark"] .mc-gov .mc-icon { color: #2dd4bf; border-color: rgba(45,212,191,.3); }
    [data-theme="dark"] .mc-rep .mc-icon { color: #93c5fd; border-color: rgba(147,197,253,.3); }

    .mc-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: var(--r-control, 8px);
      background: var(--surface-alt);
      color: var(--text-muted);
      border: 1px solid var(--border);
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .mc-title {
      font-size: 1.08rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 .4rem 0;
      line-height: 1.3;
    }
    .mc-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
      margin: 0 0 .85rem 0;
      min-height: 44px;
    }
    .mc-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .45rem;
      border-top: 1px solid var(--border);
      padding: .8rem 0 0 0;
      margin: 0;
    }
    .mc-features li {
      font-size: 12px;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 8px;
      line-height: 1.4;
    }
    .mc-features li svg {
      width: 14px;
      height: 14px;
      color: var(--primary);
      flex-shrink: 0;
    }

    /* ── Rodapé da Capa ── */
    .home-footer {
      text-align: center;
      padding: 1.15rem 1.5rem;
      font-size: 12px;
      color: var(--text-secondary);
      background: transparent;
      flex-shrink: 0;
    }
    .home-footer .hh-bimbo-logo { margin: 0 auto; }

    /* ── Adaptação Responsiva Tablet (641px - 1024px) ── */
    @media (max-width: 1024px) and (min-width: 641px) {
      .modules-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.15rem;
      }
      .modules-grid > .mc-wrap {
        grid-column: span 1 !important;
      }
      /* Centraliza o 5º módulo (Relatórios) na 3ª linha */
      .modules-grid > .mc-wrap.mc-rep {
        grid-column: 1 / -1 !important;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
      }
    }

    /* ── Adaptação Responsiva Mobile (<= 640px) ── */
    @media (max-width: 640px) {
      body.home-page {
        justify-content: flex-start;
      }
      .home-header {
        padding: 0.65rem 1rem;
      }
      .hh-logo-area {
        gap: 12px;
      }
      .dna-logo-img {
        height: 42px;
        max-height: 44px;
      }
      .hh-divider {
        height: 18px;
      }
      .hh-bimbo-logo {
        height: 18px;
        max-height: 20px;
      }
      .home-hero {
        padding: 1.25rem 1rem 0.5rem;
      }
      .hero-eyebrow {
        font-size: 11px;
      }
      .hero-page-title {
        font-size: clamp(1.45rem, 6.5vw, 1.9rem);
      }
      .hero-subtitle {
        font-size: 0.88rem;
        line-height: 1.45;
      }
      .modules-section {
        padding: 0 1rem;
        margin: 0.5rem auto 1.25rem;
      }
      .modules-grid {
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }
      .modules-grid > .mc-wrap {
        grid-column: span 1 !important;
        padding: 1.15rem 1.2rem;
      }
      .mc-desc {
        font-size: 13px;
        min-height: auto;
        margin-bottom: 0.75rem;
      }
      .mc-features {
        padding-top: 0.7rem;
        gap: 0.4rem;
      }
      .mc-features li {
        font-size: 12px;
      }
      .home-footer {
        padding: 1rem;
        font-size: 12px;
        margin-top: auto;
      }
    }
  </style>
