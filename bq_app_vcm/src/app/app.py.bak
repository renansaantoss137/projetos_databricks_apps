@app.route("/<path:filename>")
def serve_static(filename):
    for base in [APP_DIR, "."]:
        target = os.path.join(base, filename)
        if os.path.exists(target):
            return send_from_directory(base, filename)
    return send_from_directory(APP_DIR, filename)


